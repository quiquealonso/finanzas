# Copy to back/.env and fill in. back/.env is never committed (see .gitignore).
PORT=3000
# Supabase Postgres (Project settings > Database > Connection pooling).
# DIRECT_URL: pooler in SESSION mode (port 5432). Used by the app, the scripts and the Prisma CLI (prisma.config.ts).
DIRECT_URL="postgresql://postgres.<proyecto>:<contraseña>@<host>:5432/postgres"
# DATABASE_URL: pooler in transaction mode (port 6543). Only a fallback: Prisma 7 + pg hang on it (docs/02-arquitectura.md).
DATABASE_URL="postgresql://postgres.<proyecto>:<contraseña>@<host>:6543/postgres"
# Key that signs the login tokens. Created by `npm run set-password` the first time (48 random bytes).
AUTH_SECRET=""
# Optional. Google AI Studio key from a project WITHOUT billing (free tier). Used by Sentimiento and the fund finder.
GEMINI_API_KEY=""
# Optional. Old price provider.
ALPHA_VANTAGE_API_KEY=""
