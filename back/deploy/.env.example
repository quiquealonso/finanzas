# Copy to .env in this folder ON THE VM (never in Git) and fill it in. chmod 600 .env
# docs/09-despliegue.md explains each one.

# Domain of the API: the VM's IP with dashes + .sslip.io (Let's Encrypt gives it a certificate).
API_DOMAIN=1-2-3-4.sslip.io

# Supabase, session pooler (port 5432). Use the NEW database password (rotated for the server).
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Signs the session tokens. A NEW one, different from your computer's: openssl rand -base64 48
AUTH_SECRET=

# Only the published app can call the API from a browser.
CORS_ORIGINS=https://quiquealonso.github.io

# Registration: the word you tell in person, and how many accounts at most. Empty REGISTER_CODE = closed.
REGISTER_CODE=
REGISTER_MAX=5

# The only user that can refresh shared data (prices, sentiment, valuations).
OWNER_USER=user1

# Not here on purpose: GEMINI_API_KEY, EB_APP_ID, the Gmail token and the Enable Banking .pem
# (INTEGRATIONS=off in docker-compose.yml: they stay on your computer).
