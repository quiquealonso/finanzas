{
    "name": "front",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "build:electron": "ng build --configuration production",
        "electron": "electron .",
        "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:4200 && npm run electron\"",
        "electron-build": "npm run build:electron && electron-builder"
    },
    "private": true,
    "packageManager": "npm@11.6.2",
    "dependencies": {
        "@angular/common": "^21.2.26",
        "@angular/compiler": "^21.2.26",
        "@angular/core": "^21.2.26",
        "@angular/forms": "^21.2.26",
        "@angular/platform-browser": "^21.2.26",
        "@angular/router": "^21.2.26",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^21.2.26",
        "@angular/cli": "^21.2.26",
        "@angular/compiler-cli": "^21.2.26",
        "concurrently": "^9.2.1",
        "electron": "^41.1.0",
        "electron-builder": "^26.8.1",
        "prettier": "^3.8.1",
        "typescript": "~5.9.2",
        "wait-on": "^9.0.4"
    },
    "main": "electron-main.js",
    "homepage": "./",
    "build": {
        "appId": "com.finanzas.app",
        "productName": "finanzas",
        "directories": {
            "buildResources": "public",
            "output": "dist-electron"
        },
        "files": [
            "electron-main.js",
            "preload.js",
            "dist/front/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        }
    }
}
